# Copy to .env (git-ignored). The backend and Hardhat both read this file.

# --- Backend: on-chain anchoring ---
# Local Hardhat node (npm run node + npm run deploy:local in contracts/):
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_CONTRACT_ADDRESS=
CHAIN_DEPLOY_BLOCK=0
# Hardhat's public test account #0. Never fund it on a real network.
CHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Sepolia: use a dedicated throwaway wallet, then point the CHAIN_* values above at the same network.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# --- Optional threat-intel keys ---
URLHAUS_AUTH_KEY=
GSB_API_KEY=
DATABASE_URL=
CLERK_PUBLISHABLE_KEY=

# --- Network exposure ---
# Comma-separated. Defaults allow only localhost. Set both when serving real users.
# CORS_ORIGINS=https://app.example.com
# ALLOWED_HOSTS=api.example.com
# HOST=0.0.0.0
# Only needed if the signing key is not on this server. Records from any other address are rejected.
# CHAIN_TRUSTED_REPORTER=
# ANCHOR_MAX_PER_HOUR=60
